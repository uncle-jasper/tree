{
  "id": "amber-crt",
  "label": "amber crt (Konami, session only)",
  "app": "tree",
  "madeFrom": "b0daef2",
  "settings": {
    "version": 1,
    "theme": "terminal",
    "font": "'iAWriterMonoS', monospace",
    "fontSize": "18",
    "autohide": false,
    "showWelcome": true,
    "crtEnabled": true,
    "downpour": false,
    "rainStill": false,
    "scrollSynced": true,
    "customBg": "#f5f0e8",
    "customText": "#2c2416",
    "customAccent": "#8b6e4e",
    "custom2Bg": "#f5f0e8",
    "custom2Text": "#2c2416",
    "custom2Accent": "#8b6e4e",
    "custom3Bg": "#f5f0e8",
    "custom3Text": "#2c2416",
    "custom3Accent": "#8b6e4e",
    "customName": "",
    "custom2Name": "",
    "custom3Name": "",
    "customCursor": "line",
    "custom2Cursor": "line",
    "custom3Cursor": "line",
    "showChars": true,
    "showLines": true,
    "showReadtime": true,
    "showCursor": true,
    "spellcheck": true,
    "typewriterMode": false,
    "zenMode": false,
    "zenGranularity": "sentence",
    "previewFont": "",
    "mode": "write",
    "goalTarget": 0,
    "goalBaseline": 0,
    "timeGoalMin": 0,
    "timeGoalSpent": 0
  },
  "session": "amber-crt",
  "after": {
    "pack": "retro",
    "theme": "terminal",
    "switches": {
      "crt": true
    },
    "note": "amber crt becomes an ordinary Retro theme; a saved setting can only ever say terminal + crt"
  }
}
